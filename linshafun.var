#-------------------------------------------------------------------------------
# Directory variables.
#-------------------------------------------------------------------------------
SUDOERS_CONF_DIR_PATH="/etc/sudoers.d"

USER_DIR_PATH="/home/$SUDO_USER"
USER_LOG_DIR_PATH="$USER_DIR_PATH/log"

SSH_DIR_PATH="$USER_DIR_PATH/.ssh"

SETUP_CONF_DIR_PATH="$USER_DIR_PATH/.config"

SERVICES_DIR_PATH="$USER_DIR_PATH/services"
SETUP_DIR_PATH="$SERVICES_DIR_PATH/setup"

#-------------------------------------------------------------------------------
# File variables.
#-------------------------------------------------------------------------------
SUDOERS_PATH='/etc/sudoers'
SUDOERS_DEFAULT_CONF_PATH="$SUDOERS_CONF_DIR_PATH/99-default-env-keep"

#-------------------------------------------------------------------------------
# The user's shell profile file, which always holds exactly one path. Uses
# "$USER_DIR_PATH/.bashrc", unless only "$USER_DIR_PATH/.bash_profile" exists.
#
# N.B.
# If neither file exists, "$USER_DIR_PATH/.bashrc" is used, and is created when
# a variable is first added to it. Debian, Ubuntu and Raspberry Pi OS source
# ".bashrc" from ".profile" for bash, whereas creating ".bash_profile" would
# stop bash login shells reading ".profile".
#-------------------------------------------------------------------------------
PROFILE_PATH="$USER_DIR_PATH/.bashrc"

if [ ! -f "$PROFILE_PATH" ] && [ -f "$USER_DIR_PATH/.bash_profile" ]; then
  PROFILE_PATH="$USER_DIR_PATH/.bash_profile"
fi

SSH_CONF_PATH="$SSH_DIR_PATH/config"
SSH_AUTH_KEYS_PATH="$SSH_DIR_PATH/authorized_keys"